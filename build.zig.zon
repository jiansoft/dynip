.{
    // `.name` 是這個 Zig package 自己的名稱。
    // 這裡填的是 `dynip`，也就是目前專案主要對外使用的名字。
    .name = .dynip,

    // `.version` 是這份 package manifest 自己宣告的版本，必須是合法的語意化版本。
    //
    // 這裡採用和 `CHANGELOG.md` 一致的 `YY.M.D` 日期版本。
    // （先前這個欄位填的是建立專案時所用的 Zig 版本字串，
    //   那是 Zig 自己的版本，不是本專案的版本，容易誤導。）
    .version = "26.8.14",

    // 本專案可建置的最低 Zig 版本。
    //
    // 為什麼要寫：這份程式碼用到多個仍在變動中的 0.17-dev API，
    // 例如 `std.Io`、`std.process.Init` 形式的 main、`std.Io.Writer.Allocating`。
    // 用較舊的 Zig 建置只會得到一長串難以判讀的編譯錯誤，
    // 這個欄位讓「需要哪個版本」有一個明確、可查的出處。
    //
    // 注意：Zig 0.17.0-dev.1282 只會「解析」這個欄位，**不會對本專案強制檢查**。
    // （實測把它設成 `99.0.0`，`zig build` 仍然成功且沒有任何警告。）
    // 所以目前它的作用是文件與前瞻性宣告，不是一道真正的關卡；
    // 若日後 Zig 開始強制檢查，這裡已經是正確的值。
    //
    // 這裡填的是目前實際驗證過可通過 `zig build` 與 `zig build test` 的版本。
    .minimum_zig_version = "0.17.0-dev.1282+c0f9b51d8",

    // `.dependencies` 用來列出這個專案依賴的其他 package。
    // 如果專案沒有任何第三方依賴，這裡就可以是空的。
    .dependencies = .{
        // `.okredis` 是這個 dependency 在本專案裡使用的名稱。
        // 後面 `build.zig` 會透過這個名字去抓依賴。
        .okredis = .{
            // `.path` 代表這個依賴不是從網路下載，
            // 而是直接使用專案裡的本地資料夾。
            // 目前我們把 okredis 放在 `vendor/okredis`。
            .path = "vendor/okredis",
        },
    },

    // `.paths` 用來告訴 Zig：
    // 這個 package 哪些檔案與資料夾算是「屬於這個 package 的內容」。
    //
    // `""` 代表整個專案根目錄。
    .paths = .{""},

    // `.fingerprint` 是這份 `build.zig.zon` 的指紋值。
    // 只要這個檔案內容改變，Zig 可能就會要求你更新這個值。
    .fingerprint = 0x1ad48e7ec64baf0e,
}
